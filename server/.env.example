# Copy this file to .env and fill in your own values.
# NEVER put your real .env on GitHub.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/electronics-store

# Auth - a long random string, keep it secret
JWT_SECRET=change-this-to-a-long-random-secret-string

# Chapa payment (get keys at https://dashboard.chapa.co after signup)
CHAPA_SECRET_KEY=chasecret_xxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=chasecret_xxxxxxxxxxxxxxxx
